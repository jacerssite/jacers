{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?_route=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
